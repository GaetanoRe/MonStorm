# ==============================================================================
# MonStorm — .gitattributes
# Unity 6 (6000.3.12f1), URP. Asset Serialization = Force Text.
#
# Purpose:
#   1. Normalise line endings across a mixed Linux/Windows team.
#   2. Mark Unity's YAML assets as text so they diff and merge.
#   3. Mark real binaries as binary so git stops trying to diff them.
#   4. (Optional, off by default) route heavy art through Git LFS.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Default handling
# ------------------------------------------------------------------------------
# Detect text automatically; store LF in the repo, check out native on Windows.
# The repo is already almost entirely LF, so this is close to a no-op.
* text=auto eol=lf


# ------------------------------------------------------------------------------
# 2. Unity YAML assets
# ------------------------------------------------------------------------------
# These are text ONLY because Asset Serialization is set to Force Text in
# ProjectSettings/EditorSettings.asset (m_SerializationMode: 2). If that ever
# gets switched back to Mixed/Binary, these rules become actively harmful.
#
# merge=unityyamlmerge routes conflicts through Unity's SmartMerge tool. It is
# opt-in per developer — see the note at the bottom of this file. If a developer
# has not configured it, git silently falls back to its normal text merge, so
# leaving these here is safe for everyone.

*.unity              text eol=lf merge=unityyamlmerge
*.prefab             text eol=lf merge=unityyamlmerge
*.asset              text eol=lf merge=unityyamlmerge
*.mat                text eol=lf merge=unityyamlmerge
*.anim               text eol=lf merge=unityyamlmerge
*.controller         text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial     text eol=lf merge=unityyamlmerge
*.physicsMaterial2D  text eol=lf merge=unityyamlmerge
*.playable           text eol=lf merge=unityyamlmerge
*.mask               text eol=lf merge=unityyamlmerge
*.brush              text eol=lf merge=unityyamlmerge
*.flare              text eol=lf merge=unityyamlmerge
*.fontsettings       text eol=lf merge=unityyamlmerge
*.guiskin            text eol=lf merge=unityyamlmerge
*.giparams           text eol=lf merge=unityyamlmerge
*.renderTexture      text eol=lf merge=unityyamlmerge
*.lighting           text eol=lf merge=unityyamlmerge
*.signal             text eol=lf merge=unityyamlmerge
*.spriteatlas        text eol=lf merge=unityyamlmerge
*.spriteatlasv2      text eol=lf merge=unityyamlmerge
*.terrainlayer       text eol=lf merge=unityyamlmerge
*.mixer              text eol=lf merge=unityyamlmerge
*.shadervariants     text eol=lf merge=unityyamlmerge

# .meta files must never be lost or mangled — every asset needs its pair.
*.meta               text eol=lf merge=unityyamlmerge


# ------------------------------------------------------------------------------
# 3. Source and config
# ------------------------------------------------------------------------------
*.cs                 text eol=lf diff=csharp
*.asmdef             text eol=lf
*.asmref             text eol=lf
*.inputactions       text eol=lf
*.json               text eol=lf
*.md                 text eol=lf
*.txt                text eol=lf
*.xml                text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
*.uss                text eol=lf
*.uxml               text eol=lf

# Shaders
*.shader             text eol=lf
*.shadergraph        text eol=lf
*.shadersubgraph     text eol=lf
*.compute            text eol=lf
*.cginc              text eol=lf
*.hlsl               text eol=lf
*.glslinc            text eol=lf
*.raytrace           text eol=lf

# Windows-only files that genuinely want CRLF.
*.bat                text eol=crlf
*.cmd                text eol=crlf
*.ps1                text eol=crlf
*.sln                text eol=crlf
*.csproj             text eol=crlf


